{
  "default_block": "minecraft:gravel",
  "default_fluid": "minecraft:water",
  "disable_mob_generation": true,
  "legacy_random_source": false,
  "material_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:vertical_gradient",
      "random_name": "minecraft:bedrock_floor",
      "true_at_and_below": {
        "above_bottom": 0
      },
      "false_at_and_above": {
        "above_bottom": 1
      }
    },
    "then_run": {
      "type": "minecraft:block",
      "result_state": "minecraft:bedrock"
    }
  },
  "noise": {
    "min_y": 0,
    "height": 1024
  },
  "noise_router": {
    "chunk_surface_level": 7,
    "continents": 0,
    "depth": 0,
    "erosion": 0,
    "ridges": 0,
    "temperature": 0,
    "vegetation": 0,
    "final_density": {
      "type": "minecraft:interpolated",
      "cell_size_xz": 4,
      "cell_size_y": 8,
      "input": {
        "type": "minecraft:add",
        "left": {
          "type": "minecraft:gradient",
          "axis": "y",
          "tiling": "clamp_to_edge",
          "from_coordinate": 0,
          "to_coordinate": 13,
          "from_value": 1,
          "to_value": -1
        },
        "right": {
          "type": "minecraft:mul",
          "left": 0.6,
          "right": {
            "type": "minecraft:noise",
            "noise": "minecraft:erosion",
            "xz_scale": 8,
            "y_scale": 0
          }
        }
      }
    }
  },
  "sea_level": 640,
  "spawn_target": []
}